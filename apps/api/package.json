  },
  "devDependencies": {
    "@eslint/js": "^9.25.1", "@types/bcrypt": "^5.0.2", "@types/cookie-parser": "^1.4.9", "@types/cors": "^2.8.17", "@types/express": "^5.0.1", "@types/jsonwebtoken": "^9.0.9", "@types/node": "^22.15.3", "eslint": "^9.25.1", "typescript-eslint": "^8.30.1", "tsx": "^4.19.3", "typescript": "^5.8.3", "vitest": "^3.1.2"
